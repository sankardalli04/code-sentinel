# CodeSentinel Configuration Example

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub API Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# LLM Provider Configuration (Supports: groq, openai, ollama)
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key_or_openai_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Task Queue (redis or memory)
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379/0

# Docker Sandbox Controls
DOCKER_SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_DISABLED=true
